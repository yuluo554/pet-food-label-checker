        "doc_id": "MOA-20-2018-ANNEX3",
        "doc_title": "宠物饲料标签规定（农业农村部公告第20号 附件3）",
        "excerpt": "声称应当使用“无XX”或者“不含XX”",
        "sha256": "7ee619eef87733fe82ec424d46f881855627ec404002b479ffa237cffae9ecb3",
        "source_url": "https://faolex.fao.org/docs/pdf/chn176389.pdf"
      },
      "clause_status": "verified",
      "dimension": "claim",
      "effect": "obligation",
      "kind": "claim_support",
      "note": "不含有声称须在原料组成中可核；除饲料原料与饲料添加剂外不得对物质作不含有声称。",
      "required_support": [
        "ingredients"
      ],
      "rule_id": "CLAIM-002",
      "status": "verified",
      "target": "无谷"
    },
