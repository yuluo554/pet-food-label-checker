      },
      "clause_status": "verified",
      "dimension": "label",
      "effect": "obligation",
      "kind": "presence",
      "note": "生产日期（第十三条）与保质期（第十四条）均为无条件义务，档案合并为一项字段。",
      "rule_id": "LABEL-005",
      "status": "verified",
