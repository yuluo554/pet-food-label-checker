      "dimension": "label",
      "effect": "obligation",
      "kind": "presence",
      "note": "生产企业名称及注册/生产地址为无条件义务；第三条亦将其列入标签应当标示的信息。",
      "rule_id": "LABEL-004",
      "status": "verified",
      "target": "producer"
    },
